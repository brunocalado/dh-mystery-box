{
  "id": "dh-mystery-box",
  "title": "Daggerheart: 🎁 Mystery Box",
  "version": "0.2.1",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Mestre Digital",
      "url": "http://youtube.com/@mestredigital",
      "flags": {}
    }
  ],
  "description": "Add a thrill of surprise to your Daggerheart sessions. This module lets Game Masters create item boxes—like treasure chests, magical caches, or lucky bags — that players can open to reveal random rewards.",
