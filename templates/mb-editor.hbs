<div class="dh-mb-editor-content">
    <div class="mb-editor-header">
        <label>Box Name</label>
        <input type="text" class="mb-input" name="name" value="{{name}}" placeholder="e.g. Golden Chest" maxlength="40" required>
        <input type="hidden" name="openingStyle" value="{{openingStyle}}">
        <input type="hidden" name="rarity" value="{{rarity}}">
        <input type="hidden" name="mode" value="{{mode}}">
        <input type="hidden" name="raffleCount" value="{{raffleCount}}">
        <button type="button" class="mb-config-btn" data-action="openEditorConfig" title="Box Configuration">
            <i class="fas fa-sliders"></i>
        </button>
        <button type="button" class="mb-add-btn" data-action="openImportDialog">
            <i class="fas fa-file-import"></i> Mass Import
        </button>
    </div>

    <div class="mb-item-add-zone" id="mb-item-add-zone">
        <div class="mb-item-drop empty">
            <i class="fas fa-plus"></i>
            <span class="mb-item-name">Drag Item Here to Add</span>
        </div>
    </div>

    <div class="mb-item-list" id="mb-item-list">
        {{#each items as |item|}}
        <div class="mb-item-row" data-index="{{@index}}">
            <div class="mb-item-drop filled" data-index="{{@index}}">
                <img src="{{item.img}}" class="mb-item-img" alt="{{item.name}}">
                <span class="mb-item-name">{{item.name}}</span>
                {{#if ../isRaffle}}
                  <span class="raffle-prob">({{raffleProbability item.chance ../items ../raffleCount}})</span>
                {{/if}}
            </div>
            <div class="mb-item-controls">
                <input type="range" class="chance-slider" name="chance_{{@index}}" value="{{item.chance}}" min="0" max="100" step="1">
                <span class="chance-value">
                  {{#if ../isRaffle}}
                    Weight: {{item.chance}}
                  {{else}}
                    {{item.chance}}%
                  {{/if}}
                </span>
                <button type="button" class="mb-item-remove" data-action="removeItem" data-index="{{@index}}" title="Remove">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        {{/each}}
    </div>

    <div class="mb-form-footer">
        <button type="submit">
            <i class="fas fa-save"></i> {{#if isEdit}}Save Changes{{else}}Create Box{{/if}}
        </button>
    </div>
</div>
