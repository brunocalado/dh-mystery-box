<div class="dh-mb-import-content">

  {{!-- HEADER: toggle button sempre visível + conteúdo condicional por modo --}}
    <div class="mb-import-header">

        <button type="button" class="mb-source-toggle-btn" data-action="toggleSourceMode">
            {{#if (eq sourceMode "compendium")}}
                <i class="fas fa-book"></i> Compendium
            {{else}}
                <i class="fas fa-folder-open"></i> Folder
            {{/if}}
        </button>

        {{#if (eq sourceMode "compendium")}}
            <select class="mb-import-compendium-select">
                {{#each compendiums}}
                    <option value="{{this.id}}" {{#if (eq this.id ../selectedCompendiumId)}}selected{{/if}}>
                        {{this.name}}
                    </option>
                {{/each}}
            </select>
            <button type="button" class="mb-import-load-btn" data-action="selectCompendium">
                <i class="fas fa-sync-alt"></i> Load
            </button>
        {{else}}
            <div id="mb-folder-drop-zone" class="mb-folder-drop-zone">
                <i class="fas fa-folder-open"></i>
                <span>Drag a World Folder Here</span>
            </div>
        {{/if}}

    </div>

  {{!-- BODY: toolbar + grid, conteúdo varia por modo --}}
    {{#if (eq sourceMode "compendium")}}

        {{#if hasCompendiums}}
            <div class="mb-import-toolbar">
                <div class="mb-import-toolbar-left">
                    <button type="button" class="mb-import-toggle-btn" data-action="selectAll">
                        <i class="fas fa-check-double"></i> All
                    </button>
                    <button type="button" class="mb-import-toggle-btn" data-action="deselectAll">
                        <i class="fas fa-times"></i> None
                    </button>
                    <button type="button" class="mb-import-toggle-btn" data-action="randomSelect">
                        <i class="fas fa-dice"></i> Random
                    </button>
                    <span class="mb-import-count">{{selectedCount}} selected</span>
                </div>
                <div class="mb-import-toolbar-right">
                    <span class="mb-import-chance-label">Default Chance:</span>
                    <input type="range" class="mb-import-chance-slider" min="5" max="100" step="5" value="{{defaultChance}}">
                    <span class="mb-import-chance-value">{{defaultChance}}%</span>
                </div>
            </div>

            {{#if hasItems}}
                <div class="mb-import-item-grid">
                    {{#each items}}
                        <div class="mb-import-item {{#if this.selected}}selected{{/if}}" data-index="{{this.index}}" data-action="toggleItem">
                            <img class="mb-import-item-img" src="{{this.img}}" data-uuid="{{this.uuid}}" data-action="viewItem" alt="{{this.name}}">
                            <div class="mb-import-item-info">
                                <span class="mb-import-item-name">{{this.name}}</span>
                                <span class="mb-import-item-type">{{this.type}}</span>
                            </div>
                            <i class="fas {{#if this.selected}}fa-check-square{{else}}fa-square{{/if}} mb-import-item-check"></i>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <div class="mb-empty-state">
                    <i class="fas fa-inbox"></i>
                    <p>Select a compendium and click Load to browse items.</p>
                </div>
            {{/if}}

        {{else}}
            <div class="mb-empty-state">
                <i class="fas fa-exclamation-circle"></i>
                <p>No Item compendiums with valid items found.</p>
            </div>
        {{/if}}

    {{else}}

    {{!-- Folder mode body --}}
        <div class="mb-import-toolbar">
            <div class="mb-import-toolbar-left">
                <button type="button" class="mb-import-toggle-btn" data-action="selectAll">
                    <i class="fas fa-check-double"></i> All
                </button>
                <button type="button" class="mb-import-toggle-btn" data-action="deselectAll">
                    <i class="fas fa-times"></i> None
                </button>
                <button type="button" class="mb-import-toggle-btn" data-action="randomSelect">
                    <i class="fas fa-dice"></i> Random
                </button>
                <span class="mb-import-count">{{selectedCount}} selected</span>
            </div>
            <div class="mb-import-toolbar-right">
                <span class="mb-import-chance-label">Default Chance:</span>
                <input type="range" class="mb-import-chance-slider" min="5" max="100" step="5" value="{{defaultChance}}">
                <span class="mb-import-chance-value">{{defaultChance}}%</span>
            </div>
        </div>

        {{#if hasFolderItems}}
            <div class="mb-import-item-grid">
                {{#each folderItems}}
                    <div class="mb-import-item {{#if this.selected}}selected{{/if}}" data-index="{{this.index}}" data-action="toggleItem">
                        <img class="mb-import-item-img" src="{{this.img}}" data-uuid="{{this.uuid}}" data-action="viewItem" alt="{{this.name}}">
                        <div class="mb-import-item-info">
                            <span class="mb-import-item-name">{{this.name}}</span>
                            <span class="mb-import-item-type">{{this.type}}</span>
                        </div>
                        <i class="fas {{#if this.selected}}fa-check-square{{else}}fa-square{{/if}} mb-import-item-check"></i>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <div class="mb-empty-state">
                <i class="fas fa-folder"></i>
                <p>Drop a world folder above to load its items.</p>
            </div>
        {{/if}}

    {{/if}}

  {{!-- FOOTER: botão de import sempre visível --}}
    <div class="mb-import-footer">
        <button type="button" class="mb-import-btn" data-action="importItems">
            <i class="fas fa-file-import"></i> Import Selected
        </button>
    </div>

</div>
