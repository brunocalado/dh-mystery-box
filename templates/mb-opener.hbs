<div class="d-flex flex-column gap-2 dh-mb-opener-content">
    {{#if noActor}}
    <p class="mb-notes mb-notes-warning">
        <i class="fas fa-exclamation-triangle"></i>
        No linked actor found. Please assign a character to your user profile.
    </p>
    {{else}}
        {{#if boxes.length}}
        <p class="mb-notes">
            <i class="fas fa-info-circle"></i>
            Select a Mystery Box to open. Items inside will be rolled based on their drop chance.
        </p>

        {{#if partyActorEnabled}}
        <div class="mb-party-toggle-row">
          <label class="mb-party-toggle-label" for="mb-party-toggle">
            <i class="fas fa-users"></i>
            Send loot to party (<em>{{partyActorName}}</em>)
          </label>
          <button
            type="button"
            id="mb-party-toggle"
            class="mb-party-toggle-btn"
            data-active="false"
            aria-pressed="false"
            title="When active: items go to the party actor, chat is public, and effects play for all players.">
            <span class="mb-toggle-off">OFF</span>
            <span class="mb-toggle-on">ON</span>
          </button>
        </div>
        {{/if}}

        <div class="mb-opener-grid">
            {{#each boxes as |box|}}
            <div class="mb-opener-card">
                <img src="{{box.img}}" class="mb-opener-img" alt="{{box.boxName}}">
                <div class="mb-opener-info">
                    <span class="mb-opener-name">{{box.boxName}}</span>
                    <span class="mb-opener-meta">{{box.itemCount}} possible item(s) | Qty: {{box.quantity}}</span>
                </div>
                <button type="button" data-action="openBox" data-box-id="{{box.boxId}}" data-actor-item-id="{{box.actorItemId}}" class="mb-btn-open">
                    <i class="fas fa-box-open"></i> Open
                </button>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="mb-empty-state">
            <i class="fas fa-box-open"></i>
            <p>You don't have any Mystery Boxes in your inventory.</p>
        </div>
        {{/if}}
    {{/if}}
</div>
