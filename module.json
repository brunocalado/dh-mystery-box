  "relationships": {
    "systems": [
      {
        "id": "daggerheart",
        "type": "system",
        "compatibility": {
          "minimum": "2.2.6"
        }
      }
    ],
    "recommends": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "title": "Dice So Nice!",
        "compatibility": {
          "minimum": "6.2.3"
        }
      },
      {
        "id": "dh-unidentified",
        "type": "module",
        "title": "Daggerheart: Unidentified Items",
        "compatibility": {
          "minimum": "0.1.6"
        }
      }
    ]
  },
  "media": [
    {
      "type": "setup",
      "url": "modules/dh-mystery-box/assets/images/thumbnail.webp",
      "thumbnail": "modules/dh-mystery-box/assets/images/thumbnail.webp",
      "loop": false,
      "flags": {}
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    {
      "src": "styles/mystery-box.css"
    },
    {
      "src": "styles/mb-reveal.css"
    },
    {
      "src": "styles/mb-settings.css"
    },
    {
      "src": "styles/mb-import-dialog.css"
    },
    {
      "src": "styles/mb-editor-config.css"
    },
    {
      "src": "styles/mb-actor-sheet.css"
    }
